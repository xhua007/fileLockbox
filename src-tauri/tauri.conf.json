{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileLocker",
  "version": "1.0.0",
  "identifier": "com.example.filelocker",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "文件保险箱",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "本地文件保险箱",
    "longDescription": "文件保险箱 - 使用 AES-256-GCM 加密本地文件，支持 Touch ID 和恢复码",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "dialog": {},
    "fs": {
      "scope": ["**"]
    },
    "os": {},
    "shell": {
      "open": true
    }
  }
}
